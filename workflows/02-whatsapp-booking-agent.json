{
  "name": "AI Receptionist 2: WhatsApp Booking Agent",
  "nodes": [
    {
      "id": "d697e190-48cc-4247-b3cb-0d60c9ceb27a",
      "name": "WhatsApp Message In",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "updates": [
          "messages"
        ]
      },
      "webhookId": "7787d1c4-dd6d-4db0-9817-159f9476ddb8"
    },
    {
      "id": "c54da6bb-f3bf-4449-aa2c-cb49e4328c34",
      "name": "Only Customer Text Messages",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        220,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.messages?.[0]?.text?.body ?? \"\" }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "70b6e844-ec41-4c09-8929-5adacf5798ec",
      "name": "Business Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "w1",
              "name": "businessName",
              "value": "REPLACE_ME: Your business name, e.g. Glow Salon",
              "type": "string"
            },
            {
              "id": "w2",
              "name": "businessInfo",
              "value": "REPLACE_ME: Services, prices, opening hours, address, policies (the AI only answers from this)",
              "type": "string"
            },
            {
              "id": "w3",
              "name": "timezone",
              "value": "REPLACE_ME: Business time zone, e.g. America/Toronto",
              "type": "string"
            },
            {
              "id": "w4",
              "name": "appointmentMinutes",
              "value": 60,
              "type": "number"
            },
            {
              "id": "w5",
              "name": "ownerTelegramChatId",
              "value": "REPLACE_ME: Owner Telegram chat ID",
              "type": "string"
            },
            {
              "id": "w6",
              "name": "customerPhone",
              "value": "={{ $json.messages[0].from }}",
              "type": "string"
            },
            {
              "id": "w7",
              "name": "customerName",
              "value": "={{ $json.contacts?.[0]?.profile?.name ?? \"there\" }}",
              "type": "string"
            },
            {
              "id": "w8",
              "name": "customerMessage",
              "value": "={{ $json.messages[0].text.body }}",
              "type": "string"
            },
            {
              "id": "w9",
              "name": "businessPhoneNumberId",
              "value": "={{ $json.metadata.phone_number_id }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "f0d0b8ea-1507-48e8-8d90-15d8ff369d2f",
      "name": "AI Receptionist",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        700,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Customer {{ $json.customerName }} (WhatsApp {{ $json.customerPhone }}) says: {{ $json.customerMessage }}",
        "options": {
          "systemMessage": "=You are the friendly WhatsApp receptionist for {{ $json.businessName }}.\nCurrent date and time: {{ $now.setZone($json.timezone).toFormat(\"cccc, d LLLL yyyy HH:mm\") }} ({{ $json.timezone }}).\n\nBusiness info (answer ONLY from this, never invent prices or services):\n{{ $json.businessInfo }}\n\nYour job:\n1. Answer questions briefly and warmly.\n2. To book: get the service and preferred day and time, then use check_availability for a {{ $json.appointmentMinutes }} minute slot. If busy, suggest the next free slot you checked.\n3. When the customer confirms, use book_appointment, then notify_owner with the booking details.\n4. If the customer wants a human, is upset, or asks something not in the business info, say a team member will reply soon and use notify_owner.\n\nKeep replies under 3 short sentences. Reply in the same language the customer writes in. Never say you are a bot unless asked."
        }
      }
    },
    {
      "id": "d8020a7c-3fc0-438f-8fdf-37a8c5cb9423",
      "name": "Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.1,
      "position": [
        520,
        560
      ],
      "parameters": {
        "modelName": "models/gemini-3-flash-preview",
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "dcd4ae56-4e10-4e52-86c6-84cd42e58062",
      "name": "Conversation Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        660,
        560
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Business Settings').item.json.customerPhone }}",
        "contextWindowLength": 12
      }
    },
    {
      "id": "1eed8c20-8e38-4806-b5b2-c08b4d6585c1",
      "name": "check_availability",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        800,
        560
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Check if a time slot is free in the business calendar. Pass ISO start and end date-times in the business time zone.",
        "resource": "calendar",
        "operation": "availability",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Business calendar"
        },
        "timeMin": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('start', 'Slot start as ISO date-time, e.g. 2026-11-26T16:00:00-05:00') }}",
        "timeMax": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('end', 'Slot end as ISO date-time') }}",
        "options": {
          "outputFormat": "availability"
        }
      }
    },
    {
      "id": "a39940da-e3a1-41f5-ba68-2b0e8abe35bd",
      "name": "book_appointment",
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        940,
        560
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Book an appointment in the business calendar. Only call after check_availability says the slot is free and the customer confirmed.",
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "",
          "cachedResultName": "Business calendar"
        },
        "start": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('start', 'Appointment start as ISO date-time') }}",
        "end": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('end', 'Appointment end as ISO date-time') }}",
        "additionalFields": {
          "summary": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('title', 'Short title, e.g. Haircut - Ali') }}",
          "description": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('notes', 'Service requested, customer name and WhatsApp number') }}"
        }
      }
    },
    {
      "id": "c46b1cae-6a29-481b-8ab7-fb1fe57d43b6",
      "name": "notify_owner",
      "type": "n8n-nodes-base.telegramTool",
      "typeVersion": 1.2,
      "position": [
        1080,
        560
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Send a short message to the business owner. Use after every booking, or when the customer asks for a human, complains, or asks something you cannot answer.",
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $(\"Business Settings\").item.json.ownerTelegramChatId }}",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('message', 'Message for the owner with customer name, WhatsApp number and what happened') }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "b91837cf-949b-4e58-a4c8-2023ea05e503",
      "name": "Reply on WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        1060,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "={{ $(\"Business Settings\").item.json.businessPhoneNumberId }}",
        "recipientPhoneNumber": "={{ $(\"Business Settings\").item.json.customerPhone }}",
        "messageType": "text",
        "textBody": "={{ $json.output }}"
      }
    },
    {
      "id": "c03ecd0f-165f-4b6a-b85a-697e7cf50f60",
      "name": "Setup Guide",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -40
      ],
      "parameters": {
        "content": "## WhatsApp AI Receptionist\nAnswers customer questions from your business info, checks Google Calendar, books appointments and pings the owner on Telegram.\n\n1. Fill in **Business Settings** (services, prices, hours, address)\n2. Connect WhatsApp Business Cloud, Gemini, Google Calendar and Telegram\n3. Pick your calendar in **check_availability** and **book_appointment**\n4. Activate the workflow",
        "color": 5,
        "width": 680,
        "height": 280
      }
    }
  ],
  "connections": {
    "WhatsApp Message In": {
      "main": [
        [
          {
            "node": "Only Customer Text Messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only Customer Text Messages": {
      "main": [
        [
          {
            "node": "Business Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Business Settings": {
      "main": [
        [
          {
            "node": "AI Receptionist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Receptionist": {
      "main": [
        [
          {
            "node": "Reply on WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Receptionist",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Conversation Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Receptionist",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "check_availability": {
      "ai_tool": [
        [
          {
            "node": "AI Receptionist",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "book_appointment": {
      "ai_tool": [
        [
          {
            "node": "AI Receptionist",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "notify_owner": {
      "ai_tool": [
        [
          {
            "node": "AI Receptionist",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
