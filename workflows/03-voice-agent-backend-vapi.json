            },
            {
              "id": "c4",
              "name": "endedReason",
              "value": "={{ $json.body.message.endedReason ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "c5",
              "name": "durationSeconds",
              "value": "={{ $json.body.message.durationSeconds ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "c6",
              "name": "recordingUrl",
              "value": "={{ $json.body.message.recordingUrl ?? $json.body.message.artifact?.recordingUrl ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "c7",
              "name": "transcript",
              "value": "={{ $json.body.message.transcript ?? $json.body.message.artifact?.transcript ?? \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "d1da6f20-41d1-4f46-b052-d3f84e6479ee",
      "name": "Acknowledge Other Events",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        700,
        900
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": true }"
      }
    },
