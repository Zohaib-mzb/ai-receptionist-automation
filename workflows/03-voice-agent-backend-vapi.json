        "text": "=AI receptionist call ended\nCaller: {{ $json.callerNumber }}\nLength: {{ $json.durationSeconds }}s\n\n{{ $json.summary }}\n\nRecording: {{ $json.recordingUrl }}",
        "additionalFields": {
