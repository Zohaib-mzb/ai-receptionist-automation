        [
          {
            "node": "Business Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Business Settings": {
      "main": [
        [
          {
            "node": "Qualify Lead with AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Qualify Lead with AI": {
      "main": [
        [
          {
            "node": "Build Lead Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Model": {
      "ai_languageModel": [
        [
          {
            "node": "Qualify Lead with AI",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Lead Score Format": {
      "ai_outputParser": [
        [
          {
            "node": "Qualify Lead with AI",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    },
    "Build Lead Record": {
      "main": [
        [
          {
            "node": "Text Lead Instantly",
            "type": "main",
            "index": 0
          },
          {
            "node": "Log Lead to Sheet",
            "type": "main",
            "index": 0
          },
          {
            "node": "Alert Owner on Telegram",
            "type": "main",
            "index": 0
          },
          {
            "node": "Is Hot Lead?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Hot Lead?": {
      "main": [
        [
          {
            "node": "AI Voice Call to Hot Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
